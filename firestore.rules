rules_version = '2';

// Inquiry Desk — Firestore security rules (Phase 2).
//
// The client only ever reads/writes:
//   users/{uid}       — the signed-in user's own profile
//   workspaces/{uid}  — the private workspace owned by that same uid
//
// These rules are the security boundary for the workspace data model.
// Ownership is always checked against request.auth.uid.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validDisplayName(value) {
      return value is string && value.size() > 0 && value.size() <= 100;
    }

    function validBusinessName(value) {
      return value is string && value.size() > 0 && value.size() <= 150;
    }

    function validEmail(value) {
      return value is string && value.size() > 0 && value.size() <= 254;
    }

    function hasTimestamps(create) {
      return create
        ? request.resource.data.createdAt == request.time
        : request.resource.data.updatedAt == request.time;
    }

    // ---- User profiles -------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validDisplayName(request.resource.data.displayName)
        && validEmail(request.resource.data.email)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.workspaceId == userId
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.email == resource.data.email
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isOwner(userId);
    }

    // ---- Private workspaces -------------------------------------------
    match /workspaces/{workspaceId} {
      allow read: if isOwner(workspaceId);

      allow create: if isOwner(workspaceId)
        && request.resource.data.ownerUid == request.auth.uid
        && validBusinessName(request.resource.data.businessName)
        && hasTimestamps(true);

      allow update: if isOwner(workspaceId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerUid == request.auth.uid
        && validBusinessName(request.resource.data.businessName)
        && hasTimestamps(false);

      allow delete: if isOwner(workspaceId)
        && resource.data.ownerUid == request.auth.uid;

      // Subcollections (inquiries, follow-ups, reports, etc.) belong to the
      // same workspace owner. This is the boundary that keeps one user's
      // data permanently separate from every other user's.
      match /{document=**} {
        allow read, write: if isOwner(workspaceId);
      }
    }

    // Everything else (including any future collection) is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
