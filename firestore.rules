rules_version = '2';

// Inquiry Desk — Firestore security rules.
//
// The client only ever reads/writes:
//   users/{uid}                              — the signed-in user's profile
//   workspaces/{uid}                        — the private workspace
//   workspaces/{uid}/inquiries/{id}         — inquiries in that workspace
//   workspaces/{uid}/followUps/{id}         — follow-ups in that workspace
//   workspaces/{uid}/activities/{id}        — activity events in that workspace
//
// Ownership is always checked against request.auth.uid. Nested writes must
// also stamp createdByUid with that same UID, so a client can never create a
// record on behalf of another user.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function validNullableText(value, maxLength) {
      return value == null || validText(value, maxLength);
    }

    function validTimestamp(value) {
      return value is timestamp;
    }

    function validNullableTimestamp(value) {
      return value == null || value is timestamp;
    }

    function workspaceSourceIds(workspaceId, fieldName) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
        .get('inquirySettings', {})
        .get(fieldName, ['whatsapp', 'website', 'phone', 'instagram', 'facebook', 'walk_in', 'referral', 'other']);
    }

    function validInquiryStatus(value) {
      return value in ['new', 'contacted', 'qualified', 'converted', 'lost'];
    }

    function validPriority(value) {
      return value in ['low', 'normal', 'high'];
    }

    function validFollowUpStatus(value) {
      return value in ['pending', 'completed', 'cancelled'];
    }

    function validActivityType(value) {
      return value in ['inquiry_created', 'status_changed', 'communication_logged', 'follow_up_created', 'follow_up_completed', 'follow_up_rescheduled', 'follow_up_cancelled', 'follow_up_deleted', 'note_added'];
    }

    function validCommunicationChannel(value) {
      return value in ['phone', 'whatsapp', 'email', 'sms', 'in_person', 'other'];
    }

    function validCommunicationDirection(value) {
      return value in ['incoming', 'outgoing'];
    }

    function validCommunicationOutcome(value, channel) {
      return (channel == 'phone' && value in ['connected', 'no_answer', 'voicemail'])
        || (channel == 'whatsapp' && value in ['message_sent', 'customer_replied', 'no_response'])
        || (channel == 'email' && value in ['email_sent', 'customer_replied', 'no_response'])
        || (channel == 'sms' && value in ['message_sent', 'customer_replied', 'no_response'])
        || (channel == 'in_person' && value in ['meeting_completed', 'meeting_missed'])
        || (channel == 'other' && value in ['completed', 'no_response', 'other']);
    }

    function hasTimestamps(create) {
      return create
        ? request.resource.data.createdAt == request.time
        : request.resource.data.updatedAt == request.time;
    }

    function validSettingsText(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validProfile(value) {
      return value == null || (value is map
        && validSettingsText(value.get('description', null), 2000)
        && validSettingsText(value.get('industry', null), 100)
        && validSettingsText(value.get('email', null), 254)
        && validSettingsText(value.get('phone', null), 50)
        && validSettingsText(value.get('website', null), 300)
        && validSettingsText(value.get('country', null), 100)
        && validSettingsText(value.get('city', null), 100)
        && validSettingsText(value.get('logoUrl', null), 500));
    }

    function validPreferences(value) {
      return value == null || (value is map
        && validSettingsText(value.get('timezone', null), 64)
        && value.get('dateFormat', 'MMM d, yyyy') in ['MMM d, yyyy', 'dd/MM/yyyy', 'yyyy-MM-dd', 'MM/dd/yyyy']
        && value.get('weekStartsOn', 1) in [0, 1, 6]
        && value.get('defaultReportingPeriod', '30d') in ['7d', '30d', '90d', 'thisMonth']);
    }

    function validInquirySettings(value) {
      return value == null || (value is map
        && value.get('sources', []) is list
        && value.get('sources', []).size() <= 50
        && value.get('sourceIds', []) is list
        && value.get('activeSourceIds', []) is list);
    }

    function validFollowUpSettings(value) {
      return value == null || (value is map
        && value.get('defaultIntervalDays', 3) is number
        && value.get('defaultIntervalDays', 3) >= 1
        && value.get('defaultIntervalDays', 3) <= 90
        && value.get('workingDays', []) is list
        && value.get('startTime', '09:00') is string
        && value.get('endTime', '17:00') is string
        && value.get('defaultTime', '10:00') is string);
    }

    // ---- User profiles -------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validText(request.resource.data.displayName, 100)
        && validText(request.resource.data.email, 254)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.workspaceId == userId
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && validText(request.resource.data.displayName, 100)
        && request.resource.data.email == resource.data.email
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'workspaceId', 'createdAt']);

      allow delete: if isOwner(userId);
    }

    // ---- Private workspace ---------------------------------------------
    match /workspaces/{workspaceId} {
      allow read: if isOwner(workspaceId);

      allow create: if isOwner(workspaceId)
        && request.resource.data.ownerUid == request.auth.uid
        && validText(request.resource.data.businessName, 150)
        && hasTimestamps(true);

      allow update: if isOwner(workspaceId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerUid == request.auth.uid
        && validText(request.resource.data.businessName, 150)
        && hasTimestamps(false)
        && request.resource.data.keys().hasOnly(['businessName', 'ownerUid', 'createdAt', 'updatedAt', 'profile', 'preferences', 'inquirySettings', 'followUpSettings'])
        && validProfile(request.resource.data.get('profile', null))
        && validPreferences(request.resource.data.get('preferences', null))
        && validInquirySettings(request.resource.data.get('inquirySettings', null))
        && validFollowUpSettings(request.resource.data.get('followUpSettings', null));

      allow delete: if isOwner(workspaceId)
        && resource.data.ownerUid == request.auth.uid;

      // ---- Inquiries ----------------------------------------------------
      match /inquiries/{inquiryId} {
        allow read: if isOwner(workspaceId);

        allow create: if isOwner(workspaceId)
          && request.resource.data.createdByUid == request.auth.uid
          && validText(request.resource.data.fullName, 100)
          && validText(request.resource.data.phone, 50)
          && validNullableText(request.resource.data.email, 254)
          && validText(request.resource.data['service'], 150)
          && request.resource.data.source in workspaceSourceIds(workspaceId, 'activeSourceIds')
          && validInquiryStatus(request.resource.data.status)
          && validPriority(request.resource.data.priority)
          && validNullableText(request.resource.data.get('notes', null), 2000)
          && request.resource.data.get('pinned', false) is bool
          && (request.resource.data.get('pinnedAt', null) == null || request.resource.data.get('pinnedAt', null) is timestamp)
          && request.resource.data.get('sortOrder', 0) is number
          && request.resource.data.get('sortOrder', 0) >= 0
          && request.resource.data.get('sortOrder', 0) <= 9007199254740991
          && request.resource.data.get('archived', false) is bool
          && validTimestamp(request.resource.data.createdAt)
          && validTimestamp(request.resource.data.updatedAt)
          && validNullableTimestamp(request.resource.data.lastContactedAt)
          && validNullableTimestamp(request.resource.data.nextFollowUpAt)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(workspaceId)
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && validText(request.resource.data.fullName, 100)
          && validText(request.resource.data.phone, 50)
          && validNullableText(request.resource.data.email, 254)
          && validText(request.resource.data['service'], 150)
          && request.resource.data.source in workspaceSourceIds(workspaceId, 'sourceIds')
          && validInquiryStatus(request.resource.data.status)
          && validPriority(request.resource.data.priority)
          && validNullableText(request.resource.data.get('notes', null), 2000)
          && request.resource.data.get('pinned', false) is bool
          && (request.resource.data.get('pinnedAt', null) == null || request.resource.data.get('pinnedAt', null) is timestamp)
          && request.resource.data.get('sortOrder', 0) is number
          && request.resource.data.get('sortOrder', 0) >= 0
          && request.resource.data.get('sortOrder', 0) <= 9007199254740991
          && request.resource.data.get('archived', false) is bool
          && validNullableTimestamp(request.resource.data.lastContactedAt)
          && validNullableTimestamp(request.resource.data.nextFollowUpAt);

        allow delete: if isOwner(workspaceId);
      }

      // ---- Follow-ups ---------------------------------------------------
      match /followUps/{followUpId} {
        allow read: if isOwner(workspaceId);

        allow create: if isOwner(workspaceId)
          && request.resource.data.createdByUid == request.auth.uid
          && validText(request.resource.data.inquiryId, 150)
          && validText(request.resource.data.customerName, 100)
          && validText(request.resource.data.title, 150)
          && validNullableText(request.resource.data.get('description', null), 2000)
          && validTimestamp(request.resource.data.dueAt)
          && validPriority(request.resource.data.get('priority', 'normal'))
          && validFollowUpStatus(request.resource.data.status)
          && validTimestamp(request.resource.data.createdAt)
          && validTimestamp(request.resource.data.updatedAt)
          && validNullableTimestamp(request.resource.data.completedAt)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(workspaceId)
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && validText(request.resource.data.inquiryId, 150)
          && validText(request.resource.data.customerName, 100)
          && validText(request.resource.data.title, 150)
          && validNullableText(request.resource.data.get('description', null), 2000)
          && validTimestamp(request.resource.data.dueAt)
          && validPriority(request.resource.data.get('priority', 'normal'))
          && validFollowUpStatus(request.resource.data.status)
          && validNullableTimestamp(request.resource.data.completedAt);

        allow delete: if isOwner(workspaceId);
      }

      // ---- Activity events (append-only) -------------------------------
      match /activities/{activityId} {
        allow read: if isOwner(workspaceId);

        allow create: if isOwner(workspaceId)
          && request.resource.data.createdByUid == request.auth.uid
          && validActivityType(request.resource.data.type)
          && validNullableText(request.resource.data.inquiryId, 150)
          && validText(request.resource.data.description, 500)
          && validTimestamp(request.resource.data.createdAt)
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      // ---- Communications (manually logged interactions) ---------------
      match /communications/{communicationId} {
        allow read: if isOwner(workspaceId);

        allow create: if isOwner(workspaceId)
          && request.resource.data.createdByUid == request.auth.uid
          && validText(request.resource.data.inquiryId, 150)
          && validCommunicationChannel(request.resource.data.channel)
          && validCommunicationDirection(request.resource.data.direction)
          && validCommunicationOutcome(request.resource.data.outcome, request.resource.data.channel)
          && validText(request.resource.data.summary, 2000)
          && validTimestamp(request.resource.data.occurredAt)
          && validTimestamp(request.resource.data.createdAt)
          && validTimestamp(request.resource.data.updatedAt)
          && validNullableText(request.resource.data.followUpId, 150)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(workspaceId)
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.inquiryId == resource.data.inquiryId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && validCommunicationChannel(request.resource.data.channel)
          && validCommunicationDirection(request.resource.data.direction)
          && validCommunicationOutcome(request.resource.data.outcome, request.resource.data.channel)
          && validText(request.resource.data.summary, 2000)
          && validTimestamp(request.resource.data.occurredAt)
          && validNullableText(request.resource.data.followUpId, 150);

        // Communication history is retained, not silently deleted.
        allow delete: if false;
      }

      // Any other nested collection is denied.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
